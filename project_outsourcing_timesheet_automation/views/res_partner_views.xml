<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="partner_form_with_outsourcing" model="ir.ui.view">
        <field name="name">Partner: add outsourcing field</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="purchase.view_partner_property_form"/>
        <field name="arch" type="xml">
            <field name="property_purchase_currency_id" position="after">
                <field name="subcontracting_auto_time_entries" invisible="not is_company and parent_id" readonly="not is_company and parent_id"/>
                <field name="employee_id" invisible="not subcontracting_auto_time_entries or (not is_company and parent_id)" required="subcontracting_auto_time_entries" readonly="not is_company and parent_id"/>
                <div name="parent_subcontracting" colspan="2" invisible="is_company or not parent_id">
                    <p>Subcontracting automation datas are managed on <button name="open_commercial_entity" type="object" string="the parent company" class="oe_link"/></p>
                </div>
            </field>
        </field>
    </record>

</odoo>